    <library_effects>
        <effect id="Joint_0_Object_0_Material_0-effect" name="Joint_0_Object_0_Material_0">
            <profile_COMMON>
                <newparam sid="Texture_0_CMP-image_surface">
                    <surface type="2D">
                        <init_from>Texture_0_CMP-image</init_from>
                    </surface>
                </newparam>
                <newparam sid="Texture_0_CMP-image_sampler">
                    <sampler2D>
                        <source>Texture_0_CMP-image_surface</source>
                        <wrap_s>CLAMP</wrap_s>
                        <wrap_t>CLAMP</wrap_t>
                    </sampler2D>
                </newparam>
                <technique sid="standard">
                    <phong>
                        <emission>
                            <color sid="emission">0 0 0 1</color>
                        </emission>
                        <ambient>
                            <color sid="ambient">0.6 0.6 0.6 1</color>
                        </ambient>
                        <diffuse>
                            <texture texture="Texture_0_CMP-image_sampler" texcoord="CHANNEL0" />
                        </diffuse>
                        <specular>
                            <color sid="specular">0 0 0 1</color>
                        </specular>
                        <reflective>
                            <color sid="reflective">1 1 1 1</color>
                        </reflective>
                        <shininess>
                            <float sid="shininess">50</float>
                        </shininess>
                        <reflectivity>
                            <float sid="reflectivity">1</float>
                        </reflectivity>
                        <transparency>
                            <float sid="transparency">1</float>
                        </transparency>
                    </phong>
                </technique>
            </profile_COMMON>
        </effect>
