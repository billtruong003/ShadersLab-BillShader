/* LiveDebuggerWindow.uss */
/* Đặt file này trong thư mục "Editor" */

.root {
    padding: 10px;
}

.header-label {
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    margin-bottom: 10px;
}

.session-controls {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
    background-color: #282828;
    padding: 5px;
    border-radius: 3px;
}

.session-dropdown {
    flex-grow: 1;
}

.session-name-field {
    flex-grow: 1;
    margin-left: 10px;
}

.session-controls Button {
    margin-left: 5px;
    min-width: 50px;
}

.drop-area {
    border-width: 2px;
    border-color: #555;
    border-radius: 5px;
    min-height: 60px;
    align-items: center;
    justify-content: center;
    margin-bottom: 10px;
    background-color: #333;
}

.drop-area:hover {
    border-color: #888;
    background-color: #383838;
}

.monitor-container {
    flex-grow: 1;
}

.inspector-box {
    background-color: #3C3C3C;
    border-radius: 5px;
    padding: 10px;
    margin-bottom: 10px;
}

.inspector-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 5px;
}

.inspector-header .unity-object-field {
    flex-grow: 1;
}

.inspector-header Button {
    width: 20px;
    height: 20px;
    margin-left: 5px;
}

.fields-container {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 10px;
}

.fields-container .unity-toggle {
    width: 33%; /* Hiển thị 3 cột */
}

.values-container {
    margin-top: 10px;
    padding-top: 5px;
    border-top-width: 1px;
    border-top-color: #4A4A4A;
}

.values-container Label {
    -unity-font-style: bold;
    color: #A0D0FF; /* Màu cho giá trị live để dễ nhìn */
}

.clear-button {
    margin-top: 10px;
    background-color: #6e2f2f;
}

.clear-button:hover {
    background-color: #8c3a3a;
}