<!-- LiveDebuggerWindow.uxml -->
<!-- Đặt file này trong thư mục "Editor" -->

<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement class="root">
        <ui:Label text="Live Debugger" class="header-label" />
        <ui:VisualElement class="session-controls">
            <ui:DropdownField name="session-dropdown" label="Session" class="session-dropdown" />
            <ui:TextField name="session-name-field" label="Lưu với tên" class="session-name-field" />
            <ui:Button name="save-button" text="Lưu" />
            <ui:Button name="delete-button" text="Xóa" />
        </ui:VisualElement>
        
        <ui:VisualElement name="drop-area" class="drop-area">
            <ui:Label text="Kéo GameObjects vào đây" />
        </ui:VisualElement>

        <ui:ScrollView name="monitor-container" class="monitor-container" />
        
        <ui:Button name="clear-button" text="Xóa Tất Cả" class="clear-button" />
    </ui:VisualElement>
</ui:UXML>