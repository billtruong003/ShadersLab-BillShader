#pragma kernel CSMain

struct GrassInstance
{
    float3 position;
    float rotY;
    float2 scale;
    uint colorSeed;
    float padding;
};

StructuredBuffer<GrassInstance> _SourceBuffer;
AppendStructuredBuffer<GrassInstance> _VisibleBuffer;

float4 _CameraPlanes[6];
float3 _CameraPosition;
float _MaxDistanceSq;
uint _Count;
float _BoundRadius;

bool IsInFrustum(float3 position, float radius)
{
    [unroll]
    for (int i = 0; i < 6; i++)
    {
        if (dot(_CameraPlanes[i].xyz, position) + _CameraPlanes[i].w + radius < 0)
            return false;
    }
    return true;
}

[numthreads(256, 1, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Count) return;

    GrassInstance instance = _SourceBuffer[id.x];
    
    float distSq = dot(instance.position - _CameraPosition, instance.position - _CameraPosition);
    if (distSq > _MaxDistanceSq) return;

    if (!IsInFrustum(instance.position, _BoundRadius)) return;

    _VisibleBuffer.Append(instance);
}